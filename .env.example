GOOGLE_OAUTH_CLIENT_ID="your_client_id_here"
GOOGLE_OAUTH_CLIENT_SECRET="your_client_secret_here"
GOOGLE_MAIL_OAUTH_REDIRECT_URI="http://localhost:5000/fuse/integration/gmail/callback"
GOOGLE_SHEETS_OAUTH_REDIRECT_URI="http://localhost:5000/fuse/integration/google_sheets/callback"

WEBEX_OAUTH_CLIENT_ID="your_webex_client_id_here"
WEBEX_OAUTH_CLIENT_SECRET="your_webex_client_secret_here"
WEBEX_OAUTH_REDIRECT_URI="http://localhost:5000/fuse/integration/webex/callback"
# Must match scopes enabled on your Webex integration (Developer Portal → My Apps → your app).
# Example for broad access: spark:all
# Example for minimal messaging: spark:messages_write spark:messages_read spark:people_read
WEBEX_OAUTH_SCOPES="spark:messages_write spark:messages_read spark:people_read spark:webhooks_write spark:rooms_read"

GITHUB_OAUTH_CLIENT_ID="your_github_client_id_here"
GITHUB_OAUTH_CLIENT_SECRET="your_github_client_secret_here"
GITHUB_OAUTH_REDIRECT_URI="http://localhost:5000/fuse/integration/github/callback"

# Fuse run live WebSocket is on the same port as Flask (GET …/live-config returns ws URL).
# Set HOST to your public API URL; live-config maps http→ws and https→wss automatically.
# HOST=http://localhost:8000
# Optional override:
# FUSE_RUN_WS_PUBLIC_URL=wss://your-api.onrender.com

DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
DEEPGRAM_LANGUAGE="en"
DEEPGRAM_SAMPLE_RATE="16000"
